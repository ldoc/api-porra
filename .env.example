# Entornos MongoDB - CAMBIAR SUFFIX SEGÚN ENTORNO
# Local/desarrollo (por defecto):
MONGODB_URI="mongodb+srv://usuario:password@porra.ojhmbig.mongodb.net/test"
# Para probar contra producción en local, cambiar a:
# MONGODB_URI="mongodb+srv://usuario:password@porra.ojhmbig.mongodb.net/prod"

JWT_SECRET=porra-ucl-champions-2026-secret-key-change-in-production
FRONTEND_URL=https://porra-spa.vercel.app
# Producción (Vercel/Render) debe definir TRUST_PROXY=1 para que el rate limit
# use la IP real de X-Forwarded-For y no la del proxy. Déjalo comentado en local
# para no confiar en una XFF spoofeable si el servidor está expuesto directo.
# TRUST_PROXY=1
PORT=3000

# Override manual del token de Sofascore (solo fallback: si el refresco
# automático con camoufox falla). Lo normal es no definir nada y dejar que
# scripts/sofascoreToken.js refresque solo. Si Sofascore endurece contra
# camoufox: abre la URL de renovación en tu navegador, copia localStorage
# "sofa.captcha.token" y o bien pégalo aquí (requiere reinicio) o mejor:
# node scripts/sofascoreToken.js --set <jwt>
# SOFASCORE_CAPTCHA_TOKEN=eyJhbGciOi...

# Ruta al binario de camoufox para el refresco automático del token de
# Sofascore (opcional; por defecto se busca en data/camoufox/*/camoufox-bin):
# CAMOUFOX_BINARIO=/ruta/a/camoufox-bin
